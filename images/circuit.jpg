<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 520" font-family="Arial, Helvetica, sans-serif" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <rect width="800" height="520" fill="#ffffff"/>
  <text x="400" y="32" font-size="20" font-weight="bold" text-anchor="middle" fill="#111">Wiring Diagram - IoT Health Monitor</text>

  <!-- Arduino -->
  <rect x="300" y="70" width="200" height="370" rx="10" fill="#0b7285" stroke="#064e5c" stroke-width="3"/>
  <text x="400" y="250" font-size="22" font-weight="bold" text-anchor="middle" fill="#fff">Arduino UNO</text>
  <text x="312" y="125" font-size="13" fill="#fff">A0</text>
  <text x="312" y="305" font-size="13" fill="#fff">D2</text>
  <text x="470" y="125" font-size="13" fill="#fff">A4</text>
  <text x="470" y="175" font-size="13" fill="#fff">A5</text>
  <text x="466" y="305" font-size="13" fill="#fff">D13</text>

  <!-- Pulse sensor -->
  <rect x="40" y="90" width="160" height="80" rx="8" fill="#ffe3e3" stroke="#c92a2a" stroke-width="2"/>
  <text x="120" y="125" font-size="15" font-weight="bold" text-anchor="middle" fill="#111">Pulse Sensor</text>
  <text x="120" y="147" font-size="12" text-anchor="middle" fill="#111">Signal / VCC / GND</text>
  <line x1="200" y1="120" x2="300" y2="120" stroke="#c92a2a" stroke-width="3"/>
  <text x="250" y="110" font-size="12" text-anchor="middle" fill="#c92a2a">Signal</text>

  <!-- DS18B20 -->
  <rect x="40" y="260" width="160" height="80" rx="8" fill="#fff3bf" stroke="#e67700" stroke-width="2"/>
  <text x="120" y="295" font-size="15" font-weight="bold" text-anchor="middle" fill="#111">DS18B20</text>
  <text x="120" y="317" font-size="12" text-anchor="middle" fill="#111">Data / VCC / GND</text>
  <line x1="200" y1="300" x2="300" y2="300" stroke="#e67700" stroke-width="3"/>
  <text x="250" y="290" font-size="12" text-anchor="middle" fill="#e67700">Data</text>

  <!-- Pull-up resistor -->
  <rect x="215" y="352" width="70" height="26" fill="#fff" stroke="#333" stroke-width="2"/>
  <text x="250" y="370" font-size="12" text-anchor="middle" fill="#111">4.7k</text>
  <line x1="250" y1="300" x2="250" y2="352" stroke="#333" stroke-width="2"/>
  <line x1="250" y1="378" x2="250" y2="410" stroke="#333" stroke-width="2"/>
  <text x="250" y="428" font-size="12" text-anchor="middle" fill="#111">to 5V (pull-up)</text>

  <!-- LCD -->
  <rect x="600" y="90" width="160" height="120" rx="8" fill="#d0ebff" stroke="#1971c2" stroke-width="2"/>
  <text x="680" y="130" font-size="15" font-weight="bold" text-anchor="middle" fill="#111">16x2 LCD</text>
  <text x="680" y="150" font-size="12" text-anchor="middle" fill="#111">with I2C backpack</text>
  <text x="680" y="170" font-size="12" text-anchor="middle" fill="#111">SDA / SCL / VCC / GND</text>
  <line x1="500" y1="120" x2="600" y2="120" stroke="#1971c2" stroke-width="3"/>
  <text x="550" y="112" font-size="12" text-anchor="middle" fill="#1971c2">SDA</text>
  <line x1="500" y1="170" x2="600" y2="170" stroke="#2f9e44" stroke-width="3"/>
  <text x="550" y="162" font-size="12" text-anchor="middle" fill="#2f9e44">SCL</text>

  <!-- LED -->
  <rect x="600" y="280" width="160" height="50" rx="8" fill="#ffe8cc" stroke="#d9480f" stroke-width="2"/>
  <text x="680" y="310" font-size="14" font-weight="bold" text-anchor="middle" fill="#111">Heartbeat LED</text>
  <line x1="500" y1="300" x2="600" y2="300" stroke="#d9480f" stroke-width="3"/>

  <!-- Power note -->
  <rect x="40" y="460" width="720" height="40" rx="6" fill="#f1f3f5" stroke="#868e96"/>
  <text x="400" y="485" font-size="13" text-anchor="middle" fill="#111">Power: every VCC goes to Arduino 5V, every GND goes to Arduino GND (common ground)</text>
</svg>
